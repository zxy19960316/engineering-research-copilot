{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-research-copilot.local/schemas/m4.2-gate-iv-a-review-r2.schema.json",
  "title": "M4.2 Gate IV-A r2 independent review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reviewed_head",
    "reviewed_tree",
    "reviewed_branch",
    "reviewed_artifacts",
    "prior_blocked_review",
    "repair_evidence",
    "matrix_checks",
    "identity_checks",
    "lineage_checks",
    "request_binding_checks",
    "historical_preservation",
    "zero_state",
    "lifecycle_requirements",
    "review_delivery",
    "findings",
    "limitations",
    "reviewer_side_effects",
    "decision",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "m4.2-gate-iv-a-review-r2-v1"
    },
    "reviewed_head": {
      "$ref": "#/$defs/gitObjectId"
    },
    "reviewed_tree": {
      "$ref": "#/$defs/gitObjectId"
    },
    "reviewed_branch": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_artifacts": {
      "type": "array",
      "minItems": 19,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifactBinding"
      }
    },
    "prior_blocked_review": {
      "$ref": "#/$defs/priorBlockedReview"
    },
    "repair_evidence": {
      "$ref": "#/$defs/repairEvidence"
    },
    "matrix_checks": {
      "$ref": "#/$defs/matrixChecks"
    },
    "identity_checks": {
      "$ref": "#/$defs/identityChecks"
    },
    "lineage_checks": {
      "$ref": "#/$defs/lineageChecks"
    },
    "request_binding_checks": {
      "$ref": "#/$defs/requestBindingChecks"
    },
    "historical_preservation": {
      "$ref": "#/$defs/historicalPreservation"
    },
    "zero_state": {
      "$ref": "#/$defs/zeroState"
    },
    "lifecycle_requirements": {
      "$ref": "#/$defs/lifecycleRequirements"
    },
    "review_delivery": {
      "$ref": "#/$defs/reviewDelivery"
    },
    "findings": {
      "type": "array",
      "maxItems": 0,
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reviewer_side_effects": {
      "type": "array",
      "maxItems": 0,
      "items": {
        "type": "string"
      }
    },
    "decision": {
      "enum": [
        "PENDING_M4_2_GATE_IV_A_R2_EXACT_HEAD_CI",
        "APPROVE_M4_2_GATE_IV_B_PROTOCOL_PROOF_ONLY"
      ]
    },
    "status": {
      "enum": [
        "M4_2_GATE_IV_A_R2_LOCAL_REVIEW_PASSED_PENDING_EXACT_HEAD_CI",
        "M4_2_GATE_IV_A_REVIEW_PASSED_NOT_AUTHORIZED"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "review_delivery": {
            "properties": {
              "status": {
                "const": "PENDING_EXACT_HEAD_CI"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "decision": {
            "const": "PENDING_M4_2_GATE_IV_A_R2_EXACT_HEAD_CI"
          },
          "status": {
            "const": "M4_2_GATE_IV_A_R2_LOCAL_REVIEW_PASSED_PENDING_EXACT_HEAD_CI"
          }
        }
      },
      "else": {
        "properties": {
          "decision": {
            "const": "APPROVE_M4_2_GATE_IV_B_PROTOCOL_PROOF_ONLY"
          },
          "status": {
            "const": "M4_2_GATE_IV_A_REVIEW_PASSED_NOT_AUTHORIZED"
          }
        }
      }
    }
  ],
  "$defs": {
    "gitObjectId": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "git_blob_oid",
        "raw_sha256",
        "byte_length"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "git_blob_oid": {
          "$ref": "#/$defs/gitObjectId"
        },
        "raw_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "priorBlockedReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head",
        "tree",
        "branch",
        "artifact",
        "pull_request",
        "decision",
        "status",
        "finding_count",
        "reviewer_side_effects"
