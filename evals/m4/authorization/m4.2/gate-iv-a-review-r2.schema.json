        },
        "decision": {
          "const": "BLOCKED"
        },
        "status": {
          "const": "BLOCKED"
        },
        "finding_count": {
          "const": 3
        },
        "reviewer_side_effects": {
          "type": "array",
          "maxItems": 0,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "eolBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "git_blob_oid",
        "raw_sha256",
        "byte_length",
        "crlf_count",
        "lf_count",
        "text_attribute",
        "eol_attribute",
        "worktree_equals_blob"
      ],
      "properties": {
        "path": {
          "type": "string",
