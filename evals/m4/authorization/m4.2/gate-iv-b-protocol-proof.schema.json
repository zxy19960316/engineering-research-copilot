            "PowerShell 7 on Ubuntu"
          ]
        },
        "status": {
          "const": "VERIFIED"
        },
        "checked_task_count": {
          "const": 60
        },
        "mismatches": {
          "type": "array",
          "maxItems": 0
        },
        "side_effects": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "accepted_proof_head",
        "push",
        "pull_request",
        "powershell_5_1",
        "powershell_7",
        "semantic_results_match"
      ],
      "properties": {
        "status": {
          "enum": [
            "PENDING_EXACT_HEAD_CI",
            "VERIFIED_TRUE_GREEN"
          ]
        },
        "accepted_proof_head": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40}$"
        },
        "push": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/deliveryRun"}
          ]
        },
        "pull_request": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/deliveryRun"}
          ]
        },
        "powershell_5_1": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/runtimeResult"}
          ]
        },
        "powershell_7": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/runtimeResult"}
          ]
        },
        "semantic_results_match": {
          "type": ["boolean", "null"]
        }
      }
    }
  }
}
