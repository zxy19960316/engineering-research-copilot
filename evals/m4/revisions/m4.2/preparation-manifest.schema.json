{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-research-copilot.local/m4/revisions/m4.2/preparation-manifest.schema.json",
  "title": "M4.2 successor preparation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "milestone",
    "revision",
    "status",
    "predecessor",
    "source_preparation",
    "authority",
    "lifecycle_requirements",
    "matrix",
    "randomization",
    "execution_helper",
    "tasks",
    "counters"
  ],
  "properties": {
    "schema_version": {"const": "m4.2-successor-preparation-v1"},
    "milestone": {"const": "M4"},
    "revision": {"const": "M4.2"},
    "status": {"const": "PREPARATION_ONLY"},
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terminal_closure_head",
        "terminal_closure_ci_run_id",
        "terminal_closure_ci_conclusion",
        "terminal_evidence_head",
        "launch_claim",
        "execution_terminal",
        "failure_evidence",
        "authorization_token_status",
        "claim_count",
        "terminal_state",
        "failed_stage",
        "successor_revision_required",
        "counts",
        "later_gates"
      ],
      "properties": {
        "terminal_closure_head": {"const": "e6ae2be7695ce1d2613dcd39e379ff458c1b60fe"},
        "terminal_closure_ci_run_id": {"const": 31301984766},
        "terminal_closure_ci_conclusion": {"const": "success"},
        "terminal_evidence_head": {"const": "80b54697c3e27a5dad0a24d5318ce26c8fe46141"},
        "launch_claim": {
          "allOf": [{"$ref": "#/$defs/evidence_binding"}],
          "properties": {
            "path": {"const": "evals/m4/execution/m4.1/launch-claim.json"},
            "byte_length": {"const": 24078},
            "sha256": {"const": "c16a2e53aa2e9215e2325464d547356afdb73897bfc7d29605e0105b9987b3c6"},
            "git_blob_oid": {"const": "794058739b96598955216b3960b95b0feea1208f"}
          }
        },
        "execution_terminal": {
          "allOf": [{"$ref": "#/$defs/evidence_binding"}],
          "properties": {
            "path": {"const": "evals/m4/execution/m4.1/execution-terminal.json"},
            "byte_length": {"const": 3707},
            "sha256": {"const": "7305d71ba94cd209f5bb0cb2c977db3bb157d95b907f8f59df9133c192f4d66e"},
            "git_blob_oid": {"const": "76c7dc1ef88d587741d364536c86e389c296ad5c"}
          }
        },
        "failure_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["raw_evidence_sha256", "observed_protocol_error"],
          "properties": {
            "raw_evidence_sha256": {"const": "61a18842ac13637f9ba71a5dac6547d1fcbd4355127f97ea213e0ea44941f9c5"},
            "observed_protocol_error": {"const": "authorization_already_claimed"}
          }
        },
        "authorization_token_status": {"const": "CONSUMED"},
        "claim_count": {"const": 1},
        "terminal_state": {"const": "STOPPED_PROTOCOL_OR_INFRASTRUCTURE_FAILURE"},
        "failed_stage": {"const": "post_claim_dual_confirmation"},
        "successor_revision_required": {"const": true},
        "counts": {"$ref": "#/$defs/terminal_counts"},
        "later_gates": {"$ref": "#/$defs/later_gates"}
      }
    },
    "source_preparation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "head",
        "ci_run_id",
        "ci_conclusion",
        "byte_length",
        "raw_sha256",
        "git_blob_oid",
        "task_count",
        "source_order_sha256"
      ],
      "properties": {
        "path": {"const": "evals/m4/revisions/m4.1/preparation-manifest.json"},
        "head": {"const": "fedc5cdeebd7a2943afeb6767d39841305c55444"},
        "ci_run_id": {"const": 31248424046},
        "ci_conclusion": {"const": "success"},
        "byte_length": {"const": 85962},
        "raw_sha256": {"const": "d66ad9d513d8e64307f9a1553242d9b7d840ea5432d084b06d86707c1b4c2b61"},
        "git_blob_oid": {"const": "42a10d36e4d64ab98aa724114b904001107f557d"},
        "task_count": {"const": 60},
        "source_order_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fresh_execution_authorized",
        "fresh_tasks_authorized",
        "result_writes_authorized",
        "retry_authorized",
        "repair_authorized",
        "authorization_artifact",
        "model_binding_status"
      ],
      "properties": {
        "fresh_execution_authorized": {"const": false},
        "fresh_tasks_authorized": {"const": false},
        "result_writes_authorized": {"const": false},
        "retry_authorized": {"const": false},
        "repair_authorized": {"const": false},
        "authorization_artifact": {"type": "null"},
        "model_binding_status": {"const": "UNBOUND_UNTIL_SEPARATE_AUTHORIZATION"}
      }
    },
    "lifecycle_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_aware_post_claim_confirmation_required",
        "post_claim_claim_absence_checks_authorized",
        "canonical_claim_path_integration_test_required",
        "same_revision_continuation_authorized"
      ],
      "properties": {
        "claim_aware_post_claim_confirmation_required": {"const": true},
        "post_claim_claim_absence_checks_authorized": {"const": false},
        "canonical_claim_path_integration_test_required": {"const": true},
        "same_revision_continuation_authorized": {"const": false}
      }
    },
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_count", "arm_count", "planned_task_count", "batch_count", "batches"],
      "properties": {
        "case_count": {"const": 12},
        "arm_count": {"const": 5},
        "planned_task_count": {"const": 60},
        "batch_count": {"const": 6},
        "batches": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {"$ref": "#/$defs/batch"}
        }
      }
    },
    "randomization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frozen",
        "policy",
        "source_seed",
        "task_order",
        "blind_mapping",
        "judge_mapping_access_authorized"
      ],
      "properties": {
        "frozen": {"const": true},
        "policy": {"const": "INHERITED_M4_1_RELATIVE_ORDER_WITH_DISJOINT_IDENTITIES"},
        "source_seed": {"const": "m4.0-order-v1"},
        "task_order": {
          "type": "array",
          "minItems": 60,
          "maxItems": 60,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^M4\\.2-(?!BATCH-)[A-Z0-9.-]+$"}
        },
        "blind_mapping": {
          "type": "object",
          "minProperties": 60,
          "maxProperties": 60,
          "propertyNames": {"pattern": "^M4\\.2-(?!BATCH-)[A-Z0-9.-]+$"},
          "additionalProperties": {"type": "string", "pattern": "^M4-J(?:12[1-9]|1[3-7][0-9]|180)$"}
        },
        "judge_mapping_access_authorized": {"const": false}
      }
    },
    "execution_helper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "raw_sha256",
        "read_only",
        "minimum_windows_powershell_version",
        "request_binding_count"
      ],
      "properties": {
        "path": {"const": "evals/m4/execution/prepare_m4_2_request_bundles.ps1"},
        "raw_sha256": {"$ref": "#/$defs/sha256"},
        "read_only": {"const": true},
        "minimum_windows_powershell_version": {"const": "5.1"},
        "request_binding_count": {"const": 60}
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 60,
      "maxItems": 60,
      "items": {"$ref": "#/$defs/task"}
    },
    "counters": {"$ref": "#/$defs/counters"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "evidence_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "byte_length", "sha256", "git_blob_oid"],
      "properties": {
        "path": {"type": "string"},
        "byte_length": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "git_blob_oid": {"$ref": "#/$defs/git_oid"}
      }
    },
    "terminal_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tasks",
        "threads",
        "attempts",
        "finalizations",
        "results",
        "retries",
        "repairs",
        "followups",
        "judge_calls",
        "aggregation_calls",
        "side_effects"
      ],
      "properties": {
        "tasks": {"const": 0},
        "threads": {"const": 0},
        "attempts": {"const": 0},
        "finalizations": {"const": 0},
        "results": {"const": 0},
        "retries": {"const": 0},
        "repairs": {"const": 0},
        "followups": {"const": 0},
        "judge_calls": {"const": 0},
        "aggregation_calls": {"const": 0},
        "side_effects": {"const": 0}
      }
    },
    "later_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "judge",
        "m4_closure",
        "m5",
        "threshold_decision",
        "unblinding_and_aggregation"
      ],
      "properties": {
        "judge": {"const": "NOT_RUN"},
        "m4_closure": {"const": "NOT_RUN"},
        "m5": {"const": "NOT_STARTED"},
        "threshold_decision": {"const": "NOT_RUN"},
        "unblinding_and_aggregation": {"const": "NOT_RUN"}
      }
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_id",
        "source_batch_id",
        "root_batch_id",
        "domain",
        "task_ids",
        "source_task_ids",
        "root_task_ids",
        "planned_task_count",
        "stop_on_infrastructure_or_protocol_failure",
        "later_batches_mutable_after_observation"
      ],
      "properties": {
        "batch_id": {"type": "string", "pattern": "^M4\\.2-BATCH-[A-Z]+$"},
        "source_batch_id": {"type": "string", "pattern": "^M4\\.1-BATCH-[A-Z]+$"},
        "root_batch_id": {"type": "string", "pattern": "^M4-BATCH-[A-Z]+$"},
        "domain": {"type": "string"},
        "task_ids": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^M4\\.2-(?!BATCH-)[A-Z0-9.-]+$"}
        },
        "source_task_ids": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^M4\\.1-(?!BATCH-)[A-Z0-9.-]+$"}
        },
        "root_task_ids": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^M4-(?!BATCH-)[A-Z0-9.-]+$"}
        },
        "planned_task_count": {"const": 10},
        "stop_on_infrastructure_or_protocol_failure": {"const": true},
        "later_batches_mutable_after_observation": {"const": false}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "source_task_id",
        "root_task_id",
        "blind_id",
        "source_blind_id",
        "root_blind_id",
        "case_id",
        "domain",
        "case_type",
        "arm_id",
        "batch_id",
        "source_batch_id",
        "root_batch_id",
        "case_path",
        "case_sha256",
        "user_input_sha256",
        "task_protocol_sha256",
        "variant_instruction_path",
        "variant_instruction_sha256",
        "rubric_sha256",
        "execution_constraints_sha256",
        "result_root",
        "result_root_must_be_absent",
        "request_binding_sha256"
      ],
      "properties": {
        "task_id": {"type": "string", "pattern": "^M4\\.2-(?!BATCH-)[A-Z0-9.-]+$"},
        "source_task_id": {"type": "string", "pattern": "^M4\\.1-(?!BATCH-)[A-Z0-9.-]+$"},
        "root_task_id": {"type": "string", "pattern": "^M4-(?!BATCH-)[A-Z0-9.-]+$"},
        "blind_id": {"type": "string", "pattern": "^M4-J(?:12[1-9]|1[3-7][0-9]|180)$"},
        "source_blind_id": {"type": "string", "pattern": "^M4-J(?:0(?:6[1-9]|[7-9][0-9])|1[01][0-9]|120)$"},
        "root_blind_id": {"type": "string", "pattern": "^M4-J(?:00[1-9]|0[1-5][0-9]|060)$"},
        "case_id": {"type": "string"},
        "domain": {"type": "string"},
        "case_type": {"enum": ["ordinary", "adversarial"]},
        "arm_id": {"enum": ["N", "F", "A1", "A2", "A3"]},
        "batch_id": {"type": "string", "pattern": "^M4\\.2-BATCH-[A-Z]+$"},
        "source_batch_id": {"type": "string", "pattern": "^M4\\.1-BATCH-[A-Z]+$"},
        "root_batch_id": {"type": "string", "pattern": "^M4-BATCH-[A-Z]+$"},
        "case_path": {"type": "string"},
        "case_sha256": {"$ref": "#/$defs/sha256"},
        "user_input_sha256": {"$ref": "#/$defs/sha256"},
        "task_protocol_sha256": {"$ref": "#/$defs/sha256"},
        "variant_instruction_path": {"type": ["string", "null"]},
        "variant_instruction_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "rubric_sha256": {"$ref": "#/$defs/sha256"},
        "execution_constraints_sha256": {"$ref": "#/$defs/sha256"},
        "result_root": {"type": "string", "pattern": "^evals/m4/results/m4\\.2/M4\\.2-(?!BATCH-)[A-Z0-9.-]+$"},
        "result_root_must_be_absent": {"const": true},
        "request_binding_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorized_tasks",
        "created_contexts",
        "dispatched_tasks",
        "finalizations",
        "results_observed",
        "judge_scores",
        "retries",
        "repairs",
        "unauthorized_side_effects"
      ],
      "properties": {
        "authorized_tasks": {"const": 0},
        "created_contexts": {"const": 0},
        "dispatched_tasks": {"const": 0},
        "finalizations": {"const": 0},
        "results_observed": {"const": 0},
        "judge_scores": {"const": 0},
        "retries": {"const": 0},
        "repairs": {"const": 0},
        "unauthorized_side_effects": {"const": 0}
      }
    }
  }
}
