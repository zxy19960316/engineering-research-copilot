      "expected_counters": {"composer": 1, "validator": 0, "retry": 0}
    },
    {
      "case_id": "leading_prose_object",
      "raw_text": "Here is the object: {\"ok\":true}",
      "expected_status": "terminal_not_accepted",
      "expected_reason": "payload_invalid_json",
      "expected_counters": {"composer": 1, "validator": 0, "retry": 0}
    },
    {
      "case_id": "truncated_object",
      "raw_text": "{\"ok\":",
      "expected_status": "terminal_not_accepted",
      "expected_reason": "payload_invalid_json",
      "expected_counters": {"composer": 1, "validator": 0, "retry": 0}
    },
    {
      "case_id": "utf8_bom_object",
      "raw_hex": "efbbbf7b226f6b223a747275657d",
