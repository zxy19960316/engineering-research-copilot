{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M3.1 model payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "coaching_mode",
    "method_cards",
    "domain_overlays"
  ],
  "properties": {
    "coaching_mode": {
      "type": "string",
      "enum": [
        "bounded",
        "route_specific"
      ]
    },
    "method_cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/method_card"
      }
    },
    "domain_overlays": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/domain_overlay"
      }
    }
  },
  "$defs": {
    "non_empty_text": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_text_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_text"
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_type",
        "metric_id",
        "operator",
        "value",
        "unit"
      ],
      "properties": {
        "criterion_type": {
          "type": "string",
          "enum": [
            "stop",
            "pivot"
          ]
        },
        "metric_id": {
          "$ref": "#/$defs/non_empty_text"
        },
        "operator": {
          "type": "string",
          "enum": [
            "<",
            "<=",
            ">",
            ">="
          ]
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "$ref": "#/$defs/non_empty_text"
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource",
        "required_value",
        "unit",
        "source_constraint_id"
      ],
      "properties": {
        "resource": {
          "$ref": "#/$defs/non_empty_text"
        },
        "required_value": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "$ref": "#/$defs/non_empty_text"
        },
        "source_constraint_id": {
          "$ref": "#/$defs/non_empty_text"
        }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraint_id",
        "resource",
        "operator",
        "value",
        "unit"
      ],
      "properties": {
        "constraint_id": {
          "$ref": "#/$defs/non_empty_text"
        },
        "resource": {
          "$ref": "#/$defs/non_empty_text"
        },
        "operator": {
          "type": "string",
          "enum": [
            "<",
            "<=",
            ">",
            ">="
          ]
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "$ref": "#/$defs/non_empty_text"
        }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supported_claim_types",
        "required_inputs",
        "incompatible_conditions"
      ],
      "properties": {
        "supported_claim_types": {
          "$ref": "#/$defs/non_empty_text_list"
        },
        "required_inputs": {
          "$ref": "#/$defs/non_empty_text_list"
        },
        "incompatible_conditions": {
          "$ref": "#/$defs/non_empty_text_list"
        }
      }
    },
    "source_ledger_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "candidate_id",
        "basis_level",
        "support_types",
        "supports",
        "does_not_support",
        "limitations"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/non_empty_text"
        },
        "candidate_id": {
          "$ref": "#/$defs/non_empty_text"
        },
        "basis_level": {
          "type": "string",
          "enum": [
            "metadata",
            "abstract",
            "full_text"
          ]
        },
        "support_types": {
          "$ref": "#/$defs/non_empty_text_list"
        },
        "supports": {
          "$ref": "#/$defs/non_empty_text_list"
        },
        "does_not_support": {
          "$ref": "#/$defs/non_empty_text_list"
        },
        "limitations": {
          "$ref": "#/$defs/non_empty_text_list"
        }
      }
    },
    "method_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "card_id",
        "method_family",
        "applicability",
        "assumptions",
        "minimum_resources",
        "inherited_constraints",
        "baselines",
        "controls",
        "procedure_outline",
        "primary_metrics",
        "uncertainty_handling",
        "validation_checks",
        "failure_modes",
        "stop_conditions",
        "pivot_conditions",
        "safety_boundaries",
        "source_ledger"
      ],
      "properties": {
        "schema_version": {
          "const": "m3.1"
        },
        "card_id": {
          "$ref": "#/$defs/non_empty_text"
        },
        "method_family": {
          "type": "string",
          "enum": [
            "experiment_measurement_uq",
            "modeling_simulation_vvuq",
            "control_optimization_identification",
            "signal_diagnostics",
            "data_ml_hybrid",
            "reliability_safety_risk"
          ]
        },
        "applicability": {
          "$ref": "#/$defs/applicability"
        },
        "assumptions": {
          "$ref": "#/$defs/non_empty_text_list"
        },
        "minimum_resources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/resource"
          }
        },
        "inherited_constraints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/constraint"
          }
        },
        "baselines": {
          "$ref": "#/$defs/non_empty_text_list"
        },
        "controls": {
          "$ref": "#/$defs/non_empty_text_list"
        },
        "procedure_outline": {
          "$ref": "#/$defs/non_empty_text_list"
        },
        "primary_metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_text"
          }
        },
        "uncertainty_handling": {
          "$ref": "#/$defs/non_empty_text_list"
        },
        "validation_checks": {
          "$ref": "#/$defs/non_empty_text_list"
        },
        "failure_modes": {
          "$ref": "#/$defs/non_empty_text_list"
        },
        "stop_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/criterion"
          }
        },
        "pivot_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/criterion"
          }
        },
        "safety_boundaries": {
          "$ref": "#/$defs/non_empty_text_list"
        },
        "source_ledger": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source_ledger_row"
          }
        }
      }
    },
    "domain_overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "overlay_id",
        "domain",
        "base_card_ids",
        "additional_assumptions",
        "additional_failure_modes",
        "additional_validation_checks",
        "additional_stop_conditions",
        "specialist_review_boundaries",
        "transfer_status",
        "source_ledger"
      ],
      "properties": {
        "schema_version": {
          "const": "m3.1"
        },
        "overlay_id": {
          "$ref": "#/$defs/non_empty_text"
        },
        "domain": {
          "const": "nuclear_engineering_ml"
        },
        "base_card_ids": {
          "$ref": "#/$defs/non_empty_text_list"
        },
        "additional_assumptions": {
          "$ref": "#/$defs/non_empty_text_list"
        },
        "additional_failure_modes": {
          "$ref": "#/$defs/non_empty_text_list"
        },
        "additional_validation_checks": {
          "$ref": "#/$defs/non_empty_text_list"
        },
        "additional_stop_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/criterion"
          }
        },
        "specialist_review_boundaries": {
          "$ref": "#/$defs/non_empty_text_list"
        },
        "transfer_status": {
          "const": "hypothesis"
        },
        "source_ledger": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source_ledger_row"
          }
        }
      }
    }
  }
}


